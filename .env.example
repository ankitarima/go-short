NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://goshort:goshort@localhost:5432/goshort
REDIS_URL=redis://localhost:6379

# 64+ random chars: openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me-change-me-change-me-1234
APP_URL=http://localhost:5173
API_PORT=4000
REDIRECT_PORT=4001
DEFAULT_SHORT_DOMAIN=localhost:4001
CORS_ORIGINS=http://localhost:5173

# Express "trust proxy": number of hops (e.g. 1 behind Caddy) or CIDR list. Never "true" on public ports.
TRUST_PROXY=loopback

REDIRECT_STATUS=302
REDIRECT_CACHE_TTL_SECONDS=3600
RESERVED_SLUGS=api,admin,login,register,dashboard,settings,health,ready,metrics,favicon.ico,robots.txt

GEOIP_DATABASE_PATH=./storage/geoip/dbip-city-lite.mmdb
STORAGE_PATH=./storage

FEATURE_CUSTOM_DOMAINS=true
FEATURE_CAMPAIGNS=true
FEATURE_QR_LOGOS=true
FEATURE_PASSWORD_LINKS=true
FEATURE_API=true
