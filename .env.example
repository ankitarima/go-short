NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://goshort:goshort@localhost:5432/goshort
REDIS_URL=redis://localhost:6379

# 64+ random chars: openssl rand -hex 32
SESSION_SECRET=change-me-change-me-change-me-change-me-change-me-change-me-1234
APP_URL=http://localhost:5173
API_PORT=4000
REDIRECT_PORT=4001
# First-boot seed for the shared short domain. More are added in the console (Short domains).
DEFAULT_SHORT_DOMAIN=localhost:4001
CORS_ORIGINS=http://localhost:5173

# Express "trust proxy": number of hops (e.g. 1 behind Caddy) or CIDR list. Never "true" on public ports.
TRUST_PROXY=loopback

REDIRECT_STATUS=302
REDIRECT_CACHE_TTL_SECONDS=3600
RESERVED_SLUGS=api,admin,login,register,dashboard,settings,health,ready,metrics,favicon.ico,robots.txt

GEOIP_DATABASE_PATH=./storage/geoip/dbip-city-lite.mmdb
STORAGE_PATH=./storage

FEATURE_CUSTOM_DOMAINS=true
FEATURE_CAMPAIGNS=true
FEATURE_QR_LOGOS=true
FEATURE_PASSWORD_LINKS=true
FEATURE_API=true

# Shared secret for Caddy's on-demand TLS check (required in production): openssl rand -hex 24
INTERNAL_API_TOKEN=

# Analytics pipeline
ANALYTICS_BATCH_FLUSH_MS=250
ANALYTICS_BATCH_MAX=500
ANALYTICS_BUFFER_MAX=20000
WORKER_CONCURRENCY=4

# API keys: requests per minute per key
API_KEY_RATE_LIMIT_PER_MINUTE=600

# Cleanup / retention (unset = keep forever)
CLEANUP_ENABLED=true
# AUDIT_LOG_RETENTION_DAYS=365
# EXPIRED_LINK_DELETE_AFTER_DAYS=90
BUCKET_RETENTION_DAYS=400
# Dev/test only: allow http:// and private-network webhook URLs. NEVER enable in production.
WEBHOOK_ALLOW_INSECURE=false

# Prometheus metrics. Each process serves /metrics on its OWN port (never the public one).
# Loopback by default; set 0.0.0.0 only on a private network, and then METRICS_TOKEN is required in production.
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
# METRICS_TOKEN=            # openssl rand -hex 24 (Prometheus sends it as a bearer token)
API_METRICS_PORT=9101
REDIRECT_METRICS_PORT=9102
WORKER_METRICS_PORT=9103
