# Production settings for docker-compose.prod.yml. Copy to .env.production, fill in, and NEVER commit it.
# Generate secrets with:  openssl rand -hex 32

# Public hostnames. APP_DOMAIN serves the web app and API; DEFAULT_SHORT_DOMAIN is the FIRST short-link
# domain, used only to seed the database on first start. Add and switch short domains later in the console
# (Short domains), not here. Both need DNS A/AAAA records pointing at this server.
APP_DOMAIN=app.example.com
DEFAULT_SHORT_DOMAIN=go.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=goshort
POSTGRES_DB=goshort
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# 64+ hex chars. Also keys webhook-secret encryption and visitor-hash salts: do not lose or change it
# (changing it makes stored webhook secrets undecryptable).
SESSION_SECRET=
# Shared secret between Caddy and the API for the on-demand TLS check (openssl rand -hex 24)
INTERNAL_API_TOKEN=
# Bearer token Prometheus uses to scrape the services (openssl rand -hex 24)
METRICS_TOKEN=

# Optional
# LOG_LEVEL=info
# REDIRECT_STATUS=302
# WORKER_CONCURRENCY=4
# FEATURE_CUSTOM_DOMAINS=true
# HTTP_PORT=80
# HTTPS_PORT=443
# GRAFANA_ADMIN_PASSWORD=          # required only with --profile monitoring

# Platform console (https://APP_DOMAIN/console). Optional: live metrics and links for platform staff.
# With the monitoring profile enabled the API reads Prometheus on the private network:
# PROMETHEUS_URL=http://prometheus:9090
# Links the console shows (open in a new tab); Grafana/Prometheus are not published, so use your own proxy or SSH tunnel:
# CONSOLE_GRAFANA_URL=
# CONSOLE_PROMETHEUS_URL=
